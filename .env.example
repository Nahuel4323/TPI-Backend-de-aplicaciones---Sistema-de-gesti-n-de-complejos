# Docker Compose: copiar a .env en la raiz y completar las contrasenas.
# Este archivo es distinto de los .env de los microservicios.
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DB_PASSWORD=

# PostgreSQL de los microservicios (independiente de Keycloak).
APP_DB_PORT=5433
APP_DB_ADMIN_PASSWORD=
# Copiar cada contrasena al DB_PASSWORD del .env del servicio correspondiente.
USERS_DB_PASSWORD=
SPACES_DB_PASSWORD=
BOOKINGS_DB_PASSWORD=
