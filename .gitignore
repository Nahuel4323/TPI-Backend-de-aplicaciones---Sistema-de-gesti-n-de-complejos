# Java / Maven (todos los módulos)
**/target/
*.class
*.jar
*.war
*.ear
*.nar
*.log
hs_err_pid*
replay_pid*
.classpath
.project
.settings/
.factorypath

# Conservar Maven Wrapper y sus archivos binarios
!mvnw
!mvnw.cmd
!.mvn/
!.mvn/wrapper/
!.mvn/wrapper/**

# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws
out/

# VS Code: conservar configuración compartida del equipo
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/*.code-snippets
*.code-workspace

# Configuración privada local (las configuraciones de ejemplo se conservan)
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
**/application-local.properties
**/application-local.yml
**/application-local.yaml
!**/*.example
!**/*.sample

# Archivos temporales y del sistema operativo
*.tmp
*.temp
*.swp
*.swo
*~
.DS_Store
._*
.Spotlight-V100/
.Trashes/
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Datos y reportes locales
logs/
coverage/
.coverage

# Paquete generado para distribución
/entregables-tpi-backend.zip
